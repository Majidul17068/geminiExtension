{
  "manifest_version": 3,
  "name": "Gemini Browser Agent",
  "version": "1.0",
  "description": "A Gemini-powered browser assistant.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "identity"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Agent"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}